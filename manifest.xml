<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">

  <Id>45606220-54f4-48fa-b2ae-2ca2c30133a7</Id>
  <Version>2.0.0.0</Version>
  <ProviderName>Terrazzini and Partners</ProviderName>
  <DefaultLocale>it-IT</DefaultLocale>
  <DisplayName DefaultValue="Gestione Pratica"/>
  <Description DefaultValue="Gestione pratiche di consulenza"/>
  <IconUrl DefaultValue="https://viktor0470.github.io/gestione-pratiche/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://viktor0470.github.io/gestione-pratiche/icon-64.png"/>
  <SupportUrl DefaultValue="https://viktor0470.github.io/gestione-pratiche"/>

  <AppDomains>
    <AppDomain>https://viktor0470.github.io</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>

  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>

  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://viktor0470.github.io/gestione-pratiche/gestione-pratica.html"/>
        <RequestedHeight>550</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>

  <Permissions>ReadWriteItem</Permissions>

  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>

  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>

    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>

          <FunctionFile resid="Commands.Url"/>

          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="msgReadGroup">
                <Label resid="GroupLabel"/>

                <Control xsi:type="Button" id="btnGestionePratica">
                  <Label resid="GestionePraticaLabel"/>
                  <Supertip>
                    <Title resid="GestionePraticaLabel"/>
                    <Description resid="GestionePraticaDesc"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="GestionePratica.Url"/>
                  </Action>
                </Control>

              </Group>
            </OfficeTab>
          </ExtensionPoint>

        </DesktopFormFactor>
      </Host>
    </Hosts>

    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://viktor0470.github.io/gestione-pratiche/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://viktor0470.github.io/gestione-pratiche/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://viktor0470.github.io/gestione-pratiche/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://viktor0470.github.io/gestione-pratiche/commands.html"/>
        <bt:Url id="GestionePratica.Url" DefaultValue="https://viktor0470.github.io/gestione-pratiche/gestione-pratica.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Pratiche"/>
        <bt:String id="GestionePraticaLabel" DefaultValue="Gestione Pratica"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="GestionePraticaDesc" DefaultValue="Gestisci la pratica di consulenza"/>
      </bt:LongStrings>
    </Resources>

  </VersionOverrides>
</OfficeApp>
